<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>tasklease user worker</Description></RegistrationInfo>
  <Triggers><LogonTrigger><Enabled>true</Enabled><UserId>USER_ID</UserId></LogonTrigger></Triggers>
  <Principals>
    <Principal id="Worker">
      <UserId>USER_ID</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure><Interval>PT1M</Interval><Count>3</Count></RestartOnFailure>
  </Settings>
  <Actions Context="Worker">
    <Exec>
      <Command>C:\absolute\path\to\tl.exe</Command>
      <Arguments>--config "C:\absolute\path\to\config.toml" --worker WORKER_LABEL worker --domain DOMAIN --topic TOPIC</Arguments>
      <WorkingDirectory>C:\absolute\path\to\checkout</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
