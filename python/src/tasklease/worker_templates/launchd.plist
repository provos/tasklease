<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.tasklease.WORKER_LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/tl</string>
    <string>--config</string><string>/absolute/path/to/config.toml</string>
    <string>--worker</string><string>WORKER_LABEL</string>
    <string>worker</string>
    <string>--domain</string><string>DOMAIN</string>
    <string>--topic</string><string>TOPIC</string>
  </array>
  <key>WorkingDirectory</key><string>/absolute/path/to/checkout</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ExitTimeOut</key><integer>60</integer>
</dict>
</plist>
