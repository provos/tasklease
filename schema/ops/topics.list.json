{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasklease.dev/schema/ops/topics.list.json",
  "title": "TopicsList",
  "description": "POST /v1/topics.list. Responses are success envelopes; failures use common ErrorResponse.",
  "$defs": {
    "Request": {
      "title": "TopicsListRequest",
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "https://tasklease.dev/schema/common.json#/$defs/DomainName"
        },
        "glob": {
          "$ref": "https://tasklease.dev/schema/common.json#/$defs/TopicGlob"
        }
      },
      "required": ["domain"],
      "additionalProperties": false
    },
    "Response": {
      "title": "TopicsListResponse",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "https://tasklease.dev/schema/common.json#/$defs/TopicSummary"
          }
        }
      },
      "required": ["ok", "topics"],
      "additionalProperties": false
    }
  }
}
