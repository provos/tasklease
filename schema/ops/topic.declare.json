{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasklease.dev/schema/ops/topic.declare.json",
  "title": "TopicDeclare",
  "description": "POST /v1/topic.declare. Responses are success envelopes; failures use common ErrorResponse.",
  "$defs": {
    "Request": {
      "title": "TopicDeclareRequest",
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "https://tasklease.dev/schema/common.json#/$defs/DomainName"
        },
        "topic": {
          "$ref": "https://tasklease.dev/schema/common.json#/$defs/TopicName"
        },
        "declared": {
          "type": "boolean"
        }
      },
      "required": ["domain", "topic", "declared"],
      "additionalProperties": false
    },
    "Response": {
      "title": "TopicDeclareResponse",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": ["ok"],
      "additionalProperties": false
    }
  }
}
