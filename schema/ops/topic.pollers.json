{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasklease.dev/schema/ops/topic.pollers.json",
  "title": "TopicPollers",
  "description": "POST /v1/topic.pollers. Responses are success envelopes; failures use common ErrorResponse.",
  "$defs": {
    "Request": {
      "title": "TopicPollersRequest",
      "type": "object",
      "properties": {
        "domain": {
          "$ref": "https://tasklease.dev/schema/common.json#/$defs/DomainName"
        },
        "topic": {
          "$ref": "https://tasklease.dev/schema/common.json#/$defs/TopicName"
        }
      },
      "required": ["domain", "topic"],
      "additionalProperties": false
    },
    "Response": {
      "title": "TopicPollersResponse",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "pollers": {
          "type": "array",
          "items": {
            "$ref": "https://tasklease.dev/schema/common.json#/$defs/Poller"
          }
        }
      },
      "required": ["ok", "pollers"],
      "additionalProperties": false
    }
  }
}
